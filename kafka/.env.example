KAFKA_ADVERTISED_LISTENERS="SASL_PLAINTEXT://172.18.0.13:9092"
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_CONTROLLER_LISTENER_NAMES="CONTROLLER"
KAFKA_CONTROLLER_QUORUM_VOTERS="1@172.18.0.13:9093"
KAFKA_INTER_BROKER_LISTENER_NAME="SASL_PLAINTEXT"
KAFKA_KRAFT_MODE=true
KAFKA_LISTENERS="SASL_PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093"
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP="SASL_PLAINTEXT:SASL_PLAINTEXT,CONTROLLER:PLAINTEXT"
KAFKA_LOG_DIRS="/var/lib/kafka/data"
KAFKA_NODE_ID=1
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_OPTS="-Djava.security.auth.login.config=/opt/kafka/config/server-jaas.conf"
KAFKA_PROCESS_ROLES="broker,controller"
KAFKA_SASL_ENABLED_MECHANISMS="PLAIN"
KAFKA_SASL_MECHANISM_INTER_BROKER_PROTOCOL="PLAIN"
KAFKA_SASL_USERNAME=""
KAFKA_SASL_PASSWORD=""
