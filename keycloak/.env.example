# For a complete list of environment variables visit https://www.keycloak.org/server/all-config#category-http.

JAVA_OPTS_APPEND="-Djava.net.preferIPv4Stack=true"

KC_DB="postgres"
KC_DB_PASSWORD=""
KC_DB_SCHEMA="public"
KC_DB_URL=""
KC_DB_USERNAME=""

KC_BOOTSTRAP_ADMIN_USERNAME=""
KC_BOOTSTRAP_ADMIN_PASSWORD=""

KC_HOSTNAME_STRICT=false

KC_HTTP_ENABLED=false
KC_HTTPS_CERTIFICATE_FILE="/etc/x509/https/keycloak.crt"
KC_HTTPS_CERTIFICATE_KEY_FILE="/etc/x509/https/keycloak.key"
